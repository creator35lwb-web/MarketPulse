# =============================================
# MarketPulse Root .gitignore
# =============================================

# Secrets and credentials
secrets/
*.env
.env
.env.*
!.env.example

# n8n data
n8n-data/
*.sqlite
*.sqlite-journal

# SSL certificates
certs/
traefik/acme.json
*.pem
*.key
*.crt

# Backups
backups/
*.tar.gz
*.tar.gz.enc
*.bak

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temp files
tmp/
temp/
*.tmp
nul

# Security scan reports (may contain sensitive info)
security/reports/

# =============================================
# Solo-builder safety net (added 2026-07-14)
# =============================================
# This repo is PUBLIC. Before this block, `git add -A` would have staged ~3,520 paths —
# node_modules, local AI-agent state, a stray git worktree, and raw chat-log exports.
# One careless `git add -A && git push` publishes all of it, permanently and irreversibly.
# A solo builder has no code reviewer to catch that. This block is the reviewer.

# Dependencies — never belongs in git
node_modules/
package-lock.json

# Local AI-agent / editor state (never meant to be published)
.claude/
.qwen/
.cursor/
.aider*
.gemini/

# Raw chat-log / session exports — these are working notes, not documentation.
# They routinely contain paths, tokens-in-prose, and half-formed thinking.
*-connected-to-my-github-*.txt
*Qoder*.txt
*session-transcript*.txt
*.chatlog.md

# Local scratch and machine-specific helpers
*.local.json
remote-workflow-temp.json
nul

# Local working drafts — never published.
# The canonical, importable export is:
#   MarketPulse-Secure/workflows/marketpulse-workflow-CURRENT.json
MarketPulse-Secure/workflows/marketpulse-workflow-v7.*.json
MarketPulse-Secure/workflows/marketpulse-ema-watchdog-*.json
MarketPulse-Secure/workflows/marketpulse-news-sentinel-*.json
MarketPulse-Secure/workflows/marketpulse-service-status.json
MarketPulse-Secure/workflows/HANDOFF_NOTE.md
MarketPulse-Secure/workflows/COMPATIBILITY_NOTES.md
MarketPulse-Secure/workflows/TEST_TELEGRAM_FIX.txt

# Claude Code MCP config - machine-local dev tooling, not product
.mcp.json
