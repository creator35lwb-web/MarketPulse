# Copy to .env through setup.sh, then edit values for your installation.
# The .env file is ignored by Git. Keep credentials in n8n's credential manager.

# HTTPS deployment: bare hostname only, without https:// or a path.
DOMAIN=marketpulse.example.com

# Compose passes this address to Traefik's certificate resolver.
ACME_EMAIL=your-email@example.com

# Matches the workflow's schedule timezone.
TIMEZONE=Asia/Kuala_Lumpur

# Create the owner account through n8n's first-launch UI on loopback.
# Legacy N8N_BASIC_AUTH_* settings do not create or protect an n8n account.
# API keys, the GitHub publication token and Telegram delivery settings are
# configured in n8n as described in workflows/README.md, not in this file.
